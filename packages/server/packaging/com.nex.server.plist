<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nex server launchd 服务（macOS，按用户运行）。
  安装：见同目录 install.sh，或手动：
    cp com.nex.server.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.nex.server.plist

  默认布局：
    二进制  /usr/local/bin/nex-server
    数据    ~/.nex/server-data
    日志    ~/.nex/server.log / ~/.nex/server.err.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nex.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/nex-server</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NEX_SERVER_HOST</key>
    <string>0.0.0.0</string>
    <key>NEX_SERVER_PORT</key>
    <string>3030</string>
    <key>NEX_DATA_BASE_DIR</key>
    <string>/Users/REPLACE_ME/.nex/server-data</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE_ME/.nex/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_ME/.nex/server.err.log</string>
</dict>
</plist>
